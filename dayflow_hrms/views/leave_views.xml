<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dayflow_leave_list" model="ir.ui.view">
        <field name="name">dayflow.leave.request.list</field>
        <field name="model">dayflow.leave.request</field>
        <field name="arch" type="xml">
            <list string="Leave Requests"
                  decoration-success="state=='approved'"
                  decoration-danger="state=='rejected'"
                  decoration-warning="state=='pending'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="leave_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="number_of_days"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_dayflow_leave_kanban" model="ir.ui.view">
        <field name="name">dayflow.leave.request.kanban</field>
        <field name="model">dayflow.leave.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="employee_id"/>
                <field name="leave_type"/>
                <field name="number_of_days"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <strong><field name="employee_id"/></strong>
                            <div>
                                <field name="leave_type"/> · <field name="number_of_days"/> day(s)
                            </div>
                            <div class="text-muted">
                                <field name="date_from"/> → <field name="date_to"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dayflow_leave_form" model="ir.ui.view">
        <field name="name">dayflow.leave.request.form</field>
        <field name="model">dayflow.leave.request</field>
        <field name="arch" type="xml">
            <form string="Leave Request">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'pending'"
                            groups="dayflow_hrms.group_dayflow_admin"/>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-secondary" invisible="state != 'pending'"
                            groups="dayflow_hrms.group_dayflow_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="leave_type"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="number_of_days"/>
                        </group>
                    </group>
                    <group string="Remarks">
                        <field name="remarks" nolabel="1" placeholder="Reason for leave..."/>
                    </group>
                    <group string="Admin Comment" invisible="state == 'pending'">
                        <field name="admin_comment" nolabel="1"/>
                        <field name="approver_id" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dayflow_leave_search" model="ir.ui.view">
        <field name="name">dayflow.leave.request.search</field>
        <field name="model">dayflow.leave.request</field>
        <field name="arch" type="xml">
            <search string="Search Leave Requests">
                <field name="employee_id"/>
                <field name="leave_type"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Leave Type" name="group_type" context="{'group_by': 'leave_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dayflow_leave_request" model="ir.actions.act_window">
        <field name="name">Leave Requests</field>
        <field name="res_model">dayflow.leave.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Apply for your first leave / time-off request.
            </p>
        </field>
    </record>

    <record id="action_dayflow_leave_approvals" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">dayflow.leave.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', '=', 'pending')]</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No pending leave requests. All caught up!
            </p>
        </field>
    </record>

</odoo>
