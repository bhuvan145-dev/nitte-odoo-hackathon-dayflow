<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add a Dayflow HRMS page to the standard employee form -->
    <record id="view_employee_form_dayflow_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.dayflow</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Dayflow HRMS" name="dayflow">
                    <group>
                        <group string="Identity">
                            <field name="dayflow_code"/>
                            <field name="dayflow_role"/>
                        </group>
                        <group string="Payroll">
                            <field name="currency_id" invisible="1"/>
                            <field name="dayflow_salary" readonly="1"/>
                            <field name="dayflow_bank_account" readonly="1"/>
                            <field name="dayflow_pan" readonly="1"/>
                        </group>
                    </group>
                    <group string="Documents">
                        <field name="dayflow_document_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                    <group string="Dayflow Summary">
                        <button name="action_dayflow_view_attendance" type="object"
                                string="Attendance Records" class="oe_stat_button"
                                icon="fa-calendar-check-o">
                            <field name="dayflow_attendance_count" widget="statinfo" string="Attendance"/>
                        </button>
                        <button name="action_dayflow_view_leaves" type="object"
                                string="Leave Requests" class="oe_stat_button"
                                icon="fa-plane">
                            <field name="dayflow_leave_count" widget="statinfo" string="Leave Requests"/>
                        </button>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Show the Dayflow ID right after department on the employee list -->
    <record id="view_employee_list_dayflow_inherit" model="ir.ui.view">
        <field name="name">hr.employee.list.dayflow</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="dayflow_code" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Employees action (Admin) -->
    <record id="action_dayflow_employees" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first employee to Dayflow.
            </p>
        </field>
    </record>

    <!-- My Profile action (Employee): opens straight to their own record -->
    <record id="action_dayflow_my_profile" model="ir.actions.act_window">
        <field name="name">My Profile</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>

    <!-- Payroll action (Admin): dedicated editable payroll views -->
    <record id="view_hr_employee_payroll_list" model="ir.ui.view">
        <field name="name">hr.employee.payroll.list</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <tree string="Payroll" editable="bottom">
                <field name="name"/>
                <field name="dayflow_code"/>
                <field name="job_title"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="dayflow_salary" sum="Total Monthly Payroll"/>
                <field name="dayflow_bank_account"/>
                <field name="dayflow_pan"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_employee_payroll_form" model="ir.ui.view">
        <field name="name">hr.employee.payroll.form</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <form string="Payroll">
                <sheet>
                    <group>
                        <group string="Employee">
                            <field name="name"/>
                            <field name="dayflow_code"/>
                            <field name="job_title"/>
                            <field name="company_id" invisible="1"/>
                            <field name="department_id"/>
                        </group>
                        <group string="Salary Structure">
                            <field name="currency_id" invisible="1"/>
                            <field name="dayflow_salary"/>
                            <field name="dayflow_bank_account"/>
                            <field name="dayflow_pan"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dayflow_payroll" model="ir.actions.act_window">
        <field name="name">Payroll</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_hr_employee_payroll_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hr_employee_payroll_form')})]"/>
    </record>

</odoo>
