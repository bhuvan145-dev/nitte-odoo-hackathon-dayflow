<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_dayflow" model="ir.module.category">
        <field name="name">Dayflow HRMS</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_dayflow_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="category_id" ref="module_category_dayflow"/>
        <field name="comment">Regular employee: own profile, own attendance, apply for leave.</field>
    </record>

    <record id="group_dayflow_admin" model="res.groups">
        <field name="name">HR Officer / Admin</field>
        <field name="category_id" ref="module_category_dayflow"/>
        <field name="implied_ids" eval="[(4, ref('group_dayflow_employee'))]"/>
        <field name="comment">Manages employees, approves leave &amp; attendance, controls payroll.</field>
    </record>

    <!-- Attendance: row-level access -->
    <record id="rule_dayflow_attendance_employee_own" model="ir.rule">
        <field name="name">Attendance: employee sees only own records</field>
        <field name="model_id" ref="model_dayflow_attendance"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
    </record>
    <record id="rule_dayflow_attendance_admin_all" model="ir.rule">
        <field name="name">Attendance: admin sees all records</field>
        <field name="model_id" ref="model_dayflow_attendance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dayflow_admin'))]"/>
    </record>

    <!-- Leave requests: row-level access -->
    <record id="rule_dayflow_leave_employee_own" model="ir.rule">
        <field name="name">Leave: employee sees only own requests</field>
        <field name="model_id" ref="model_dayflow_leave_request"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
    </record>
    <record id="rule_dayflow_leave_admin_all" model="ir.rule">
        <field name="name">Leave: admin sees all requests</field>
        <field name="model_id" ref="model_dayflow_leave_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dayflow_admin'))]"/>
    </record>

</odoo>
